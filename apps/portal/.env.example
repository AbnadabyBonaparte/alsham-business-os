# =============================================================================
# apps/portal — variáveis de ambiente
# =============================================================================
#
# ⚠️ NENHUM VALOR REAL ENTRA NESTE REPOSITÓRIO. Este arquivo tem só
# placeholders. O `.env.local` de verdade é ignorado pelo git e vive na sua
# máquina; em produção, nas variáveis de ambiente da Vercel.
#
# SEM ESTAS VARIÁVEIS O APP RODA ASSIM MESMO: cai no adapter de dados
# MOCKADO (dado fabricado e anônimo) e a tela funciona inteira, sem banco e
# sem login. É assim que a UI se prova sem depender de infraestrutura no ar.
# =============================================================================

# URL do projeto Supabase. Ex.: https://SEU-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave PUBLICÁVEL (anon). Pode ir ao navegador — é o que o prefixo
# NEXT_PUBLIC_ significa. No Business OS ela não dá acesso a nada sem sessão:
# `anon` não tem grant nenhum nos schemas core/recon (ver runbook).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# ⛔ A `service_role key` NÃO ENTRA AQUI, e não entra neste app.
#
# Ela ignora toda a RLS. Quem a tem, vê tudo de todos os tenants. Este painel
# fala com o banco como o USUÁRIO autenticado, sob RLS — é isso que torna o
# isolamento real em vez de confiança na tela.
#
# Há uma guarda no CI que falha o build se a string aparecer no bundle de
# cliente.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# ℹ️ NÃO EXISTE variável de tenant, e isso é decisão de segurança.
#
# O `tenant_id` do contexto vem SEMPRE da sessão cruzada com
# `core.memberships`, resolvida no servidor (`src/lib/session.ts`). Nunca da
# URL, do formulário, de cookie confiável ou de variável de ambiente.
#
# Se um dia aparecer um `NEXT_PUBLIC_TENANT_ID` aqui, é porque alguém deixou o
# cliente escolher em nome de quem opera.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# A FORJA (Etapa 14) — o portal PEDE; quem executa é apps/api
# -----------------------------------------------------------------------------
# ⚠️ Repare no que NÃO está aqui: nenhuma chave de motor, nenhum endpoint de
# fornecedor, nenhum nome de fornecedor. O portal não fala com motor nenhum.
#
# ⛔ E NENHUMA das duas tem prefixo NEXT_PUBLIC_. São lidas no servidor, em
# Server Actions. Com o prefixo, iriam para o navegador — que é o modo de
# transformar um segredo em texto público sem receber um erro sequer.
#
# Sem as duas, a forja cai no adapter MOCKADO e a tela mostra o selo de
# demonstração. Nunca um mock silencioso.

# A URL do apps/api publicado. Ex.: https://api.seu-dominio.com
ALSHAM_API_URL=

# O MESMO valor de FORGE_SECRET configurado no apps/api. É a chave da PORTA
# entre os dois apps — não a chave do motor.
FORGE_SECRET=

# -----------------------------------------------------------------------------
# O ENGENHEIRO — o agente que fala com o motor SOB A SESSÃO do usuário
# -----------------------------------------------------------------------------
# ⚠️ Diferente da Forja acima (que o portal só PEDE ao apps/api), o Engenheiro
# precisa do laço de ferramentas rodando COMO O USUÁRIO (RLS) — e isso o apps/api,
# que roda com service_role, não pode fazer. Por isso a rota `/api/engineer` lê o
# motor direto, no SERVIDOR, reaproveitando a MESMA credencial da Forja. Nenhuma
# chave nova.
#
# ⛔ NENHUMA tem prefixo NEXT_PUBLIC_ — são lidas só no servidor, nunca vão ao
# navegador. Sem elas, o Engenheiro conversa mas avisa que o motor não está ligado.
#
# ⚖️ Lei do Motor: a especificidade do fornecedor (URL, nome e valor do cabeçalho
# de versão) mora AQUI, em env — nunca no código de `apps/portal/src`, que o CI
# varre. Os valores abaixo são os mesmos que o apps/api já usa.

# A chave do motor de texto (a MESMA do apps/api). Reaproveite; não crie outra.
ALSHAM_TEXT_API_KEY=

# O endpoint da Messages API do motor. Ex.: https://<host-do-motor>/v1/messages
ALSHAM_TEXT_ENDPOINT=

# O identificador do modelo server-side (permitido pela Lei do Motor).
ALSHAM_TEXT_MODEL=

# O cabeçalho de versão do protocolo — NOME e VALOR vêm de env, não do código.
# Ex.: ALSHAM_TEXT_VERSION_HEADER=anthropic-version  ·  ALSHAM_TEXT_API_VERSION=2023-06-01
ALSHAM_TEXT_VERSION_HEADER=
ALSHAM_TEXT_API_VERSION=
